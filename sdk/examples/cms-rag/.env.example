# MongoDB (required for ingestion/indexing)
MONGODB_URI="mongodb://localhost:27017/agents"
MONGODB_DB="agents"

# OpenAI API Key (required for embeddings during ingest)
OPENAI_API_KEY="sk-proj-xxxxx"

# Optional: multi-tenant isolation
TENANT_ID="local"

# Optional: scope crawl ledger + ingest to an agent (default: shared)
# AGENT_ID="shared"

# Optional: extraction tuning
# CONTENT_SELECTOR="article, main, .content"
# TITLE_SELECTOR="h1, title"
# DEFAULT_TYPE="page"

# Optional: rendered crawl tuning
# CRAWL_TIMEOUT_MS=30000

# Crawl ledger (MongoDB collection cms_crawl_ledger): skip re-crawl within TTL, per-URL status in result.metadata.pageStatuses
# CRAWL_LEDGER_ENABLED="true"
# CRAWL_LEDGER_COLLECTION="cms_crawl_ledger"
# CRAWL_LEDGER_TTL_INDEXED_MS=604800000
# CRAWL_LEDGER_TTL_FAILURE_MS=3600000
# Shorter TTL for ledger rows with lastStatus=error (e.g. Playwright timeout); retries sooner than ttlMsFailure
# CRAWL_LEDGER_TTL_RENDER_ERROR_MS=300000
